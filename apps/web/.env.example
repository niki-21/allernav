# Required for map display and restaurant search.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# Optional server-side FastAPI bridge; use http://localhost:8000 locally.
FASTAPI_API_BASE_URL=
# Leave NEXT_PUBLIC_API_BASE_URL unset for same-origin Next.js API routes.

# Optional Gemini menu recommendations.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional expanded review refresh.
APIFY_TOKEN=

# Optional Supabase Google sign-in and community reviews.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
# Server-only: never use a NEXT_PUBLIC_ prefix for this key.
SUPABASE_SERVICE_ROLE_KEY=
